fill = stage
)
) +
geom_boxplot(
width = 0.58,
linewidth = 0.8,
alpha = 0.85,
outlier.size = 2.3
) +
scale_fill_manual(
values = STAGE_COLORS,
guide = "none"
) +
labs(
x = "Disease stage",
y = "Body temperature (°C)"
) +
theme_slide()
save_svg(
p_stage_temp,
"viz_stage_temp.svg",
width = 7.5,
height = 5.2
)
