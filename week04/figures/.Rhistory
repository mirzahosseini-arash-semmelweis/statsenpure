data.frame(
Group = bar3d_dat$Group[i],
face = "side",
order = 1:4,
xpoly = c(
x + 0.32,
x + 0.32 + depth_x,
x + 0.32 + depth_x,
x + 0.32
),
ypoly = c(
0,
depth_y,
y + depth_y,
y
)
)
})
)
p_trap_3d_bars <- ggplot() +
geom_polygon(
data = front_faces,
aes(
x = xpoly,
y = ypoly,
group = Group
),
fill = "#64748B",
color = "white",
linewidth = 0.6
) +
geom_polygon(
data = side_faces,
aes(
x = xpoly,
y = ypoly,
group = Group
),
fill = "#475569",
color = "white",
linewidth = 0.6
) +
geom_polygon(
data = top_faces,
aes(
x = xpoly,
y = ypoly,
group = Group
),
fill = "#94A3B8",
color = "white",
linewidth = 0.6
) +
scale_x_continuous(
breaks = 1:4,
labels = bar3d_dat$Group,
expand = expansion(add = c(0.5, 0.6))
) +
scale_y_continuous(
limits = c(0, 68),
expand = expansion(mult = c(0, 0))
) +
labs(
x = "Group",
y = "Number of participants"
) +
theme_slide()
save_svg(
p_trap_3d_bars,
"trap_3d_bars.svg",
width = 5,
height = 4.2
)
bar3d_dat <- expand.grid(
Group = c("A", "B", "C", "D"),
Series = c("Type 1", "Type 2", "Type 3"),
KEEP.OUT.ATTRS = FALSE,
stringsAsFactors = FALSE
) |>
mutate(
Value = c(
36, 49, 43, 57,   # Type 1
28, 44, 39, 52,   # Type 2
22, 35, 31, 46    # Type 3
),
x = rep(1:4, times = 3),
z = rep(1:3, each = 4)
)
# Perspective settings:
# bars farther "back" are shifted right and upward
depth_x <- 0.24
depth_y <- 5.5
bar_width <- 0.52
make_bar_faces <- function(dat_row) {
x <- dat_row$x
z <- dat_row$z
y <- dat_row$Value
x_shift <- (z - 1) * depth_x
y_shift <- (z - 1) * depth_y
front <- data.frame(
Group  = dat_row$Group,
Series = dat_row$Series,
z      = z,
face   = "front",
xpoly  = c(
x - bar_width / 2 + x_shift,
x + bar_width / 2 + x_shift,
x + bar_width / 2 + x_shift,
x - bar_width / 2 + x_shift
),
ypoly  = c(
y_shift,
y_shift,
y + y_shift,
y + y_shift
)
)
side <- data.frame(
Group  = dat_row$Group,
Series = dat_row$Series,
z      = z,
face   = "side",
xpoly  = c(
x + bar_width / 2 + x_shift,
x + bar_width / 2 + x_shift + depth_x,
x + bar_width / 2 + x_shift + depth_x,
x + bar_width / 2 + x_shift
),
ypoly  = c(
y_shift,
y_shift + depth_y,
y + y_shift + depth_y,
y + y_shift
)
)
top <- data.frame(
Group  = dat_row$Group,
Series = dat_row$Series,
z      = z,
face   = "top",
xpoly  = c(
x - bar_width / 2 + x_shift,
x + bar_width / 2 + x_shift,
x + bar_width / 2 + x_shift + depth_x,
x - bar_width / 2 + x_shift + depth_x
),
ypoly  = c(
y + y_shift,
y + y_shift,
y + y_shift + depth_y,
y + y_shift + depth_y
)
)
bind_rows(front, side, top)
}
bar3d_faces <- bind_rows(
lapply(seq_len(nrow(bar3d_dat)), function(i) {
make_bar_faces(bar3d_dat[i, ])
})
)
# Draw back bars first and front bars last,
# so front bars obscure part of the bars behind them.
bar3d_faces <- bar3d_faces |>
mutate(
draw_order = case_when(
z == 3 ~ 1,   # back
z == 2 ~ 2,   # middle
z == 1 ~ 3    # front
)
) |>
arrange(draw_order, xpoly)
# Simple label positions for the depth/category dimension
series_axis_labels <- data.frame(
Series = c("Type 1", "Type 2", "Type 3"),
x = max(bar3d_dat$x) + c(0.55, 0.79, 1.03),
y = c(1, 1 + depth_y, 1 + 2 * depth_y)
)
p_trap_3d_bars <- ggplot() +
geom_polygon(
data = subset(bar3d_faces, face == "front"),
aes(
x = xpoly,
y = ypoly,
group = interaction(Group, Series)
),
fill = "#64748B",
color = "white",
linewidth = 0.55
) +
geom_polygon(
data = subset(bar3d_faces, face == "side"),
aes(
x = xpoly,
y = ypoly,
group = interaction(Group, Series)
),
fill = "#475569",
color = "white",
linewidth = 0.55
) +
geom_polygon(
data = subset(bar3d_faces, face == "top"),
aes(
x = xpoly,
y = ypoly,
group = interaction(Group, Series)
),
fill = "#94A3B8",
color = "white",
linewidth = 0.55
) +
annotate(
"segment",
x = 4.55, y = 0.7,
xend = 5.25, yend = 0.7 + 2 * depth_y,
linewidth = 0.8,
color = COL_TEXT
) +
geom_text(
data = series_axis_labels,
aes(x = x, y = y, label = Series),
hjust = 0,
size = 4.1,
color = COL_TEXT
) +
annotate(
"text",
x = 5.05,
y = 1 + 2.7 * depth_y,
label = "Series",
hjust = 0,
fontface = "bold",
size = 4.6,
color = COL_TEXT
) +
scale_x_continuous(
breaks = 1:4,
labels = c("A", "B", "C", "D"),
expand = expansion(add = c(0.45, 1.45))
) +
scale_y_continuous(
limits = c(0, 76),
expand = expansion(mult = c(0, 0.02))
) +
labs(
x = "Group",
y = "Number of participants"
) +
theme_slide() +
theme(
panel.grid.major.x = element_blank()
)
save_svg(
p_trap_3d_bars,
"trap_3d_bars.svg",
width = 5.6,
height = 4.5
)
library(plot3D)
install.packages("plot3D")
library(plot3D)
library(viridis)
install.packages("viridis")
library(viridis)
# 1. Generate sample data (a 10x10 matrix matching the 0-10 axes)
set.seed(123)
x <- seq(0, 10, length.out = 10)
y <- seq(0, 10, length.out = 10)
# Generate random heights between 0 and 1.25
z <- matrix(runif(100, min = 0, max = 1.25), nrow = 10, ncol = 10)
# 2. Define a color palette that matches the image (Viridis/yellow-green-purple)
color_palette <- viridis(100)
# 3. Create the 3D bar plot
# Adjust 'theta' and 'phi' to change the viewing angle
hist3D(
x = x, y = y, z = z,
xlab = "x", ylab = "y", zlab = "",
col = color_palette,
border = NA,            # Set to "black" if you want outlines around bars
space = 0.1,            # Controls the spacing between bars
theta = -35, phi = 30,  # Viewing angles (rotation and elevation)
ticktype = "detailed",  # Shows full axis labels and values
bty = "b2",             # Grid box style
colkey = FALSE          # Hides the color legend sidebar to match the image
)
# 3. Create the 3D bar plot
# Adjust 'theta' and 'phi' to change the viewing angle
hist3D(
